# Copy to .env and fill in. Used only by docker-compose.yml.

# Database
POSTGRES_USER=learner
POSTGRES_PASSWORD=replace-with-output-of-openssl-rand-hex-24
POSTGRES_DB=learning
# Host port for Postgres. Change it if 5432 is already used on your machine.
DB_HOST_PORT=5432

# API auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters

# Allowed browser origins for the API. Must match the URL you open in the browser exactly.
CORS_ORIGINS=http://localhost:3000

# Baked into the frontend bundle at build time. Must be the URL your BROWSER uses, not "api:8000".
NEXT_PUBLIC_API_URL=http://localhost:8000